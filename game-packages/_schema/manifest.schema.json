{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "rulesetVersion": {
      "type": "string",
      "pattern": "^R(0|[1-9]\\d*)$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "parent": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "rulesetVersion": {
          "type": "string",
          "pattern": "^R(0|[1-9]\\d*)$"
        }
      },
      "required": [
        "version",
        "rulesetVersion"
      ],
      "additionalProperties": false
    },
    "changeDescription": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*@(0|[1-9]\\d*)$"
      }
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "values": {
            "minItems": 2,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      }
    },
    "researchBase": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "packageId",
    "version",
    "rulesetVersion",
    "schemaVersion",
    "changeDescription",
    "title",
    "modules"
  ],
  "additionalProperties": false
}
