{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*@(0|[1-9]\\d*)$"
    },
    "boxes": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "event",
              "limitedOp",
              "opOnly",
              "opSa",
              "pass"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "adjacency": {
      "minItems": 1,
      "type": "array",
      "items": {
        "minItems": 2,
        "maxItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "event",
            "limitedOp",
            "opOnly",
            "opSa",
            "pass"
          ]
        }
      }
    },
    "swapAfter": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "event",
          "limitedOp",
          "opOnly",
          "opSa",
          "pass"
        ]
      }
    },
    "firstEligibleAtStart": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "passIncome": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "model",
    "boxes",
    "adjacency",
    "swapAfter",
    "firstEligibleAtStart",
    "passIncome"
  ],
  "additionalProperties": false
}
