{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "supportLevels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "domestic",
              "external"
            ]
          },
          "terrain": {
            "type": "string",
            "enum": [
              "mountain",
              "plain",
              "city"
            ]
          },
          "pop": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hasSupportScale": {
            "type": "boolean"
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "recommended",
              "tune",
              "competing",
              "unresolved",
              "missing"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "pop",
          "hasSupportScale",
          "layout"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "b": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "land",
              "external"
            ]
          },
          "gate": {
            "type": "object",
            "properties": {
              "track": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "steps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              }
            },
            "required": [
              "track",
              "steps"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "recommended",
              "tune",
              "competing",
              "unresolved",
              "missing"
            ]
          }
        },
        "required": [
          "a",
          "b",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "stacking": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pieces": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "spaceKind": {
            "type": "string",
            "enum": [
              "domestic",
              "external"
            ]
          },
          "terrain": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mountain",
                "plain",
                "city"
              ]
            }
          },
          "spaces": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "recommended",
              "tune",
              "competing",
              "unresolved",
              "missing"
            ]
          }
        },
        "required": [
          "pieces",
          "max"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "spaces",
    "links",
    "stacking"
  ],
  "additionalProperties": false
}
